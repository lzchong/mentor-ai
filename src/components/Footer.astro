---
import MailIcon from "~/assets/icons/mail.svg";
import PhoneIcon from "~/assets/icons/phone.svg";

const BASE_URL = import.meta.env.BASE_URL;
const getAriaCurrent = (href: string) =>
  href === Astro.url.pathname ? "page" : undefined;
---

<footer
  class="bg-umich-blue w-full border-t-4 border-umich-maize px-4 py-12 text-sm text-white"
  role="contentinfo"
>
  <div class="mx-auto max-w-6xl">
    <div class="mb-8 grid gap-8 md:grid-cols-3">
      <div>
        <a
          href={BASE_URL}
          class="item-centers mb-4 inline-flex text-center text-2xl font-bold text-white"
          aria-label="Mentor AI - Home"
          aria-current={getAriaCurrent(BASE_URL)}
        >
          <img
            src={`${BASE_URL}favicon.svg`}
            alt=""
            class="mr-2 inline h-8 w-8"
            aria-hidden="true"
          />
          Mentor AI
        </a>
        <p class="text-white/70">
          Research on AI-mediated feedback and tools for instructors, teaching
          assistants, and students. Developed at the University of Michigan.
        </p>
      </div>
      <div>
        <h2 class="text-umich-maize mb-4 text-lg font-semibold">Links</h2>
        <ul class="space-y-2">
          <li>
            <a
              href={`${BASE_URL}about/`}
              class="hover:text-umich-maize nav-link text-white transition-colors"
              aria-current={getAriaCurrent(`${BASE_URL}about/`)}
            >
              About
            </a>
          </li>
          <li>
            <a
              href={`${BASE_URL}solution/`}
              class="hover:text-umich-maize nav-link text-white transition-colors"
              aria-current={getAriaCurrent(`${BASE_URL}solution/`)}
            >
              Solution
            </a>
          </li>
          <li>
            <a
              href={`${BASE_URL}research/`}
              class="hover:text-umich-maize nav-link text-white transition-colors"
              aria-current={getAriaCurrent(`${BASE_URL}research/`)}
            >
              Research
            </a>
          </li>
          <li>
            <a
              href={`${BASE_URL}news/`}
              class="hover:text-umich-maize nav-link text-white transition-colors"
              aria-current={getAriaCurrent(`${BASE_URL}news/`)}
            >
              News
            </a>
          </li>
          <li>
            <a
              href={`${BASE_URL}signup/`}
              class="hover:text-umich-maize nav-link text-white transition-colors"
              aria-current={getAriaCurrent(`${BASE_URL}signup/`)}
            >
              Join us
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h2 class="text-umich-maize mb-4 text-lg font-semibold">Connect</h2>
        <ul class="space-y-2">
          <li>
            <a
              href="mailto:xwanghci@umich.edu"
              class="hover:text-umich-maize nav-link flex items-center gap-2 text-white transition-colors"
            >
              <MailIcon width="20" height="20" aria-hidden="true" />
              <span class="nav-link-text">xwanghci@umich.edu</span>
            </a>
          </li>
          <li>
            <a
              href="tel:+17347632285"
              class="hover:text-umich-maize nav-link flex items-center gap-2 text-white transition-colors"
            >
              <PhoneIcon width="20" height="20" aria-hidden="true" />
              <span class="nav-link-text">+1 (734) 763-2285</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="border-t border-white/10 pt-6 text-center text-white/50">
      <p>&copy; {new Date().getFullYear()} SCH-umich. All rights reserved.</p>
    </div>
  </div>
</footer>
