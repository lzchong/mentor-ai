---
import MenuIcon from "~/assets/icons/menu.svg";
import NavLink from "~/components/NavLink.astro";

const BASE_URL = import.meta.env.BASE_URL;
const getAriaCurrent = (href: string) =>
  href === Astro.url.pathname ? "page" : undefined;
---

<header
  class="sticky top-0 z-50 w-full border-b border-gray-100 bg-white/90 px-4 py-3 shadow-sm backdrop-blur-md"
  role="banner"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href={BASE_URL}
      class="inline-flex items-center gap-2 text-xl font-bold text-umich-blue"
      aria-label="Mentor AI - Home"
      aria-current={getAriaCurrent(BASE_URL)}
    >
      <img
        src={`${BASE_URL}favicon.svg`}
        alt=""
        class="h-7 w-7"
        aria-hidden="true"
      />
      Mentor AI
    </a>

    <!-- Mobile menu button -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href={`${BASE_URL}signup/`}
        class="bg-umich-maize text-umich-blue rounded-lg px-3 py-2 text-sm font-semibold leading-none transition hover:brightness-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-umich-blue"
        aria-current={getAriaCurrent(`${BASE_URL}signup/`)}
      >
        Join Us
      </a>
      <button
        type="button"
        class="rounded-md p-1 text-gray-600 transition-colors hover:text-umich-blue md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <MenuIcon width="24" height="24" aria-hidden="true" />
      </button>
    </div>

    <!-- Desktop navigation -->
    <ul class="hidden items-center gap-1 md:flex" role="list">
      <!-- About dropdown -->
      <li class="relative" id="about-nav-item">
        <button
          type="button"
          id="about-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="about-dropdown"
          class="inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-umich-blue/5 hover:text-umich-blue focus:outline-none focus-visible:bg-umich-blue/5"
        >
          About
          <svg class="h-3.5 w-3.5 transition-transform duration-200" id="about-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          id="about-dropdown"
          role="menu"
          aria-labelledby="about-trigger"
          class="invisible absolute left-1/2 top-full z-50 mt-2 w-52 -translate-x-1/2 rounded-xl border border-gray-100 bg-white opacity-0 shadow-lg transition-all duration-150"
        >
          <div class="p-1.5">
            <a href={`${BASE_URL}about/`} role="menuitem" class="block rounded-lg px-4 py-3 transition hover:bg-gray-50">
              <p class="text-sm font-semibold text-umich-blue">Our Mission</p>
              <p class="mt-0.5 text-xs text-gray-500">Vision, goals, and impact</p>
            </a>
            <a href={`${BASE_URL}about/people/`} role="menuitem" class="block rounded-lg px-4 py-3 transition hover:bg-gray-50">
              <p class="text-sm font-semibold text-umich-blue">Our People</p>
              <p class="mt-0.5 text-xs text-gray-500">Faculty and research team</p>
            </a>
          </div>
        </div>
      </li>
      <!-- Solution dropdown -->
      <li class="relative" id="solution-nav-item">
        <button
          type="button"
          id="solution-trigger"
          aria-haspopup="true"
          aria-expanded="false"
          aria-controls="solution-dropdown"
          class="inline-flex items-center gap-1 rounded-md px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-umich-blue/5 hover:text-umich-blue focus:outline-none focus-visible:bg-umich-blue/5"
        >
          Solution
          <svg class="h-3.5 w-3.5 transition-transform duration-200" id="solution-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          id="solution-dropdown"
          role="menu"
          aria-labelledby="solution-trigger"
          class="invisible absolute left-1/2 top-full z-50 mt-2 w-64 -translate-x-1/2 rounded-xl border border-gray-100 bg-white opacity-0 shadow-lg transition-all duration-150"
        >
          <div class="p-1.5">
            <a
              href={`${BASE_URL}solution/feedbackwriter/`}
              role="menuitem"
              class="block rounded-lg px-4 py-3 transition hover:bg-gray-50"
            >
              <div class="flex items-center gap-2">
                <p class="text-sm font-semibold text-umich-blue">FeedbackWriter</p>
                <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700">Available Now</span>
              </div>
              <p class="mt-0.5 text-xs text-gray-500">AI-assisted grading for TAs</p>
            </a>
            <div
              href={`${BASE_URL}solution/draftmentors/`}
              role="menuitem"
              class="block rounded-lg px-4 py-3 transition hover:bg-gray-50"
            >
              <div class="flex items-center gap-2">
                <p class="text-sm font-semibold text-gray-400">DraftMentors</p>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-400">Coming Soon</span>
              </div>
              <p class="mt-0.5 text-xs text-gray-400">Rubric-aligned support for students</p>
            </div>
            <div
              href={`${BASE_URL}solution/instructor-dashboard/`}
              role="menuitem"
              class="block rounded-lg px-4 py-3 transition hover:bg-gray-50"
            >
              <div class="flex items-center gap-2">
                <p class="text-sm font-semibold text-gray-400">Instructor Dashboard</p>
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-400">Coming Soon</span>
              </div>
              <p class="mt-0.5 text-xs text-gray-400">Analytics and rubric management</p>
            </div>
            <div class="mt-1 border-t border-gray-100 pt-1">
              <a
                href={`${BASE_URL}solution/`}
                role="menuitem"
                class="block rounded-lg px-4 py-2.5 transition hover:bg-gray-50"
              >
                <p class="text-sm font-semibold text-umich-blue">See the full ecosystem →</p>
              </a>
            </div>
          </div>
        </div>
      </li>
      <li>
        <NavLink href={`${BASE_URL}research/`} variant="desktop">
          Research
        </NavLink>
      </li>
      <li>
        <NavLink href={`${BASE_URL}news/`} variant="desktop">News</NavLink>
      </li>
      <li class="ml-4">
        <a
          href={`${BASE_URL}signup/`}
          class="bg-umich-maize text-umich-blue rounded-lg px-4 py-2 text-sm font-semibold leading-none transition hover:brightness-95 focus:outline-none focus-visible:ring-2 focus-visible:ring-umich-blue"
          aria-current={getAriaCurrent(`${BASE_URL}signup/`)}
        >
          Join Us
        </a>
      </li>
    </ul>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="mt-3 hidden border-t border-gray-100 bg-white md:hidden"
    role="menu"
    aria-labelledby="mobile-menu-button"
  >
    <ul class="flex flex-col py-2" role="list">
      <!-- About mobile sub-menu -->
      <li>
        <button
          type="button"
          id="mobile-about-trigger"
          aria-expanded="false"
          aria-controls="mobile-about-menu"
          class="flex w-full items-center justify-between px-4 py-3 text-gray-700 font-medium transition-colors hover:bg-umich-blue/5 hover:text-umich-blue"
        >
          About
          <svg class="h-4 w-4 transition-transform duration-200" id="mobile-about-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <ul id="mobile-about-menu" class="hidden flex-col bg-gray-50" role="list">
          <li>
            <a href={`${BASE_URL}about/`} class="block px-8 py-2.5 text-sm text-gray-600 transition hover:text-umich-blue">
              Our Mission
            </a>
          </li>
          <li>
            <a href={`${BASE_URL}about/people/`} class="block px-8 py-2.5 text-sm text-gray-600 transition hover:text-umich-blue">
              Our People
            </a>
          </li>
        </ul>
      </li>
      <!-- Solution mobile sub-menu -->
      <li>
        <button
          type="button"
          id="mobile-solution-trigger"
          aria-expanded="false"
          aria-controls="mobile-solution-menu"
          class="flex w-full items-center justify-between px-4 py-3 text-gray-700 font-medium transition-colors hover:bg-umich-blue/5 hover:text-umich-blue"
        >
          Solution
          <svg class="h-4 w-4 transition-transform duration-200" id="mobile-solution-chevron" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <ul id="mobile-solution-menu" class="hidden flex-col bg-gray-50" role="list">
          <li>
            <a href={`${BASE_URL}solution/feedbackwriter/`} class="flex items-center gap-2 px-8 py-2.5 text-sm text-gray-600 transition hover:text-umich-blue">
              FeedbackWriter
              <span class="rounded-full bg-green-100 px-2 py-0.5 text-xs font-semibold text-green-700">Available Now</span>
            </a>
          </li>
          <li>
            <a href={`${BASE_URL}solution/draftmentors/`} class="flex items-center gap-2 px-8 py-2.5 text-sm text-gray-400 transition">
              DraftMentors
              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-400">Coming Soon</span>
            </a>
          </li>
          <li>
            <a href={`${BASE_URL}solution/instructor-dashboard/`} class="flex items-center gap-2 px-8 py-2.5 text-sm text-gray-400 transition">
              Instructor Dashboard
              <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-400">Coming Soon</span>
            </a>
          </li>
          <li>
            <a href={`${BASE_URL}solution/`} class="block px-8 py-2.5 text-xs text-gray-500 transition hover:text-umich-blue">
              See the full ecosystem →
            </a>
          </li>
        </ul>
      </li>
      <li>
        <NavLink href={`${BASE_URL}research/`} variant="mobile">
          Research
        </NavLink>
      </li>
      <li>
        <NavLink href={`${BASE_URL}news/`} variant="mobile">News</NavLink>
      </li>
    </ul>
  </div>
</header>

<script>
  // Desktop About dropdown
  const aboutTrigger = document.getElementById("about-trigger") as HTMLButtonElement | null;
  const aboutDropdown = document.getElementById("about-dropdown");
  const aboutChevron = document.getElementById("about-chevron");

  function openAbout() {
    if (!aboutDropdown || !aboutTrigger || !aboutChevron) return;
    aboutTrigger.setAttribute("aria-expanded", "true");
    aboutDropdown.classList.remove("invisible", "opacity-0");
    aboutChevron.style.transform = "rotate(180deg)";
  }
  function closeAbout() {
    if (!aboutDropdown || !aboutTrigger || !aboutChevron) return;
    aboutTrigger.setAttribute("aria-expanded", "false");
    aboutDropdown.classList.add("invisible", "opacity-0");
    aboutChevron.style.transform = "";
  }

  const aboutNavItem = document.getElementById("about-nav-item");
  if (aboutNavItem) {
    aboutNavItem.addEventListener("mouseenter", openAbout);
    aboutNavItem.addEventListener("mouseleave", closeAbout);
  }
  if (aboutTrigger) {
    aboutTrigger.addEventListener("click", () => {
      aboutTrigger.getAttribute("aria-expanded") === "true" ? closeAbout() : openAbout();
    });
    aboutTrigger.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { closeAbout(); aboutTrigger.focus(); }
    });
  }

  // Mobile About sub-menu
  const mobileAboutTrigger = document.getElementById("mobile-about-trigger") as HTMLButtonElement | null;
  const mobileAboutMenu = document.getElementById("mobile-about-menu");
  const mobileAboutChevron = document.getElementById("mobile-about-chevron");

  if (mobileAboutTrigger && mobileAboutMenu) {
    mobileAboutTrigger.addEventListener("click", () => {
      const isExpanded = mobileAboutTrigger.getAttribute("aria-expanded") === "true";
      mobileAboutTrigger.setAttribute("aria-expanded", String(!isExpanded));
      mobileAboutMenu.classList.toggle("hidden");
      mobileAboutMenu.classList.toggle("flex");
      if (mobileAboutChevron) {
        mobileAboutChevron.style.transform = isExpanded ? "" : "rotate(180deg)";
      }
    });
  }

  // Desktop Solution dropdown
  const solutionTrigger = document.getElementById("solution-trigger") as HTMLButtonElement | null;
  const solutionDropdown = document.getElementById("solution-dropdown");
  const solutionChevron = document.getElementById("solution-chevron");

  function openDropdown() {
    if (!solutionDropdown || !solutionTrigger || !solutionChevron) return;
    solutionTrigger.setAttribute("aria-expanded", "true");
    solutionDropdown.classList.remove("invisible", "opacity-0");
    solutionChevron.style.transform = "rotate(180deg)";
  }

  function closeDropdown() {
    if (!solutionDropdown || !solutionTrigger || !solutionChevron) return;
    solutionTrigger.setAttribute("aria-expanded", "false");
    solutionDropdown.classList.add("invisible", "opacity-0");
    solutionChevron.style.transform = "";
  }

  const solutionNavItem = document.getElementById("solution-nav-item");
  if (solutionNavItem) {
    solutionNavItem.addEventListener("mouseenter", openDropdown);
    solutionNavItem.addEventListener("mouseleave", closeDropdown);
  }

  if (solutionTrigger) {
    solutionTrigger.addEventListener("click", () => {
      const isOpen = solutionTrigger.getAttribute("aria-expanded") === "true";
      isOpen ? closeDropdown() : openDropdown();
    });
    solutionTrigger.addEventListener("keydown", (e) => {
      if (e.key === "Escape") { closeDropdown(); solutionTrigger.focus(); }
    });
  }

  document.addEventListener("click", (e) => {
    if (solutionNavItem && !solutionNavItem.contains(e.target as Node)) {
      closeDropdown();
    }
    if (aboutNavItem && !aboutNavItem.contains(e.target as Node)) {
      closeAbout();
    }
  });

  // Mobile Solution sub-menu
  const mobileSolutionTrigger = document.getElementById("mobile-solution-trigger") as HTMLButtonElement | null;
  const mobileSolutionMenu = document.getElementById("mobile-solution-menu");
  const mobileSolutionChevron = document.getElementById("mobile-solution-chevron");

  if (mobileSolutionTrigger && mobileSolutionMenu) {
    mobileSolutionTrigger.addEventListener("click", () => {
      const isExpanded = mobileSolutionTrigger.getAttribute("aria-expanded") === "true";
      mobileSolutionTrigger.setAttribute("aria-expanded", String(!isExpanded));
      mobileSolutionMenu.classList.toggle("hidden");
      mobileSolutionMenu.classList.toggle("flex");
      if (mobileSolutionChevron) {
        mobileSolutionChevron.style.transform = isExpanded ? "" : "rotate(180deg)";
      }
    });
  }

  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuButton && mobileMenu) {
    menuButton.addEventListener("click", () => {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!isExpanded));
      mobileMenu.classList.toggle("hidden");
    });

    document.addEventListener("click", (e) => {
      if (
        !menuButton.contains(e.target as Node) &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenu.classList.contains("hidden")
      ) {
        menuButton.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
      }
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
        menuButton.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
        menuButton.focus();
      }
    });
  }
</script>
