---
import MenuIcon from "~/assets/icons/menu.svg";
---

<header
  class="bg-umich-blue sticky top-0 z-50 w-full border-b px-4 py-4 shadow-sm"
  role="banner"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between"
    aria-label="Main navigation"
  >
    <a
      href="/"
      class="item-centers inline-flex text-2xl font-bold text-white"
      aria-label="Mentor AI - Home"
    >
      <img
        src="/favicon.svg"
        alt="Mentor AI Logo"
        class="mr-2 inline h-8 w-8"
      />
      Mentor AI
    </a>

    <!-- Mobile menu button -->
    <div class="flex items-center gap-3 md:hidden">
      <a
        href="/signup"
        class="bg-umich-maize text-umich-blue hover:bg-umich-blue hover:ring-umich-maize focus-visible:bg-umich-blue focus-visible:ring-umich-maize rounded-md px-3 py-2 leading-none transition hover:text-white hover:ring-2 focus:outline-none focus-visible:text-white focus-visible:ring-2 md:hidden"
      >
        Join Us!
      </a>
      <button
        type="button"
        class="hover:text-umich-maize rounded-md p-1 text-white transition-colors md:hidden"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        id="mobile-menu-button"
      >
        <MenuIcon width="24" height="24" aria-hidden="true" />
      </button>
    </div>

    <!-- Desktop navigation -->
    <ul class="hidden items-center gap-6 md:flex" role="list">
      <li>
        <a
          href="/team"
          class="rounded-md px-3 py-2 text-white transition-colors hover:bg-white/15 focus:outline-none focus-visible:bg-white/15"
          aria-current={Astro.url.pathname === "/team" ? "page" : undefined}
        >
          Our Team
        </a>
      </li>
      <li>
        <a
          href="/project"
          class="rounded-md px-3 py-2 text-white transition-colors hover:bg-white/15 focus:outline-none focus-visible:bg-white/15"
          aria-current={Astro.url.pathname === "/project" ? "page" : undefined}
        >
          Research
        </a>
      </li>
      <li>
        <a
          href="/news"
          class="rounded-md px-3 py-2 text-white transition-colors hover:bg-white/15 focus:outline-none focus-visible:bg-white/15"
          aria-current={Astro.url.pathname === "/news" ? "page" : undefined}
        >
          News
        </a>
      </li>
      <li>
        <a
          href="/signup"
          class="bg-umich-maize text-umich-blue hover:bg-umich-blue hover:ring-umich-maize focus-visible:ring-umich-maize focus-visible:bg-umich-blue rounded-md px-3 py-2 leading-none transition hover:text-white hover:ring-2 focus:outline-none focus-visible:text-white focus-visible:ring-2"
        >
          Join Us!
        </a>
      </li>
    </ul>
  </nav>

  <!-- Mobile menu -->
  <div
    id="mobile-menu"
    class="bg-umich-blue mt-4 hidden border-t border-gray-200 md:hidden"
    role="menu"
    aria-labelledby="mobile-menu-button"
  >
    <ul class="flex flex-col pt-4" role="list">
      <li>
        <a
          href="/team"
          class="hover:text-umich-blue hover:bg-umich-maize block px-4 py-3 text-white transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "/team" ? "page" : undefined}
        >
          Our Team
        </a>
      </li>
      <li>
        <a
          href="/project"
          class="hover:bg-umich-maize hover:text-umich-blue block px-4 py-3 text-white transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "/project" ? "page" : undefined}
        >
          Research
        </a>
      </li>
      <li>
        <a
          href="/news"
          class="hover:text-umich-blue hover:bg-umich-maize block px-4 py-3 text-white transition-colors"
          role="menuitem"
          aria-current={Astro.url.pathname === "/news" ? "page" : undefined}
        >
          News
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  // Mobile menu toggle functionality
  const menuButton = document.getElementById("mobile-menu-button");
  const mobileMenu = document.getElementById("mobile-menu");

  if (menuButton && mobileMenu) {
    menuButton.addEventListener("click", () => {
      const isExpanded = menuButton.getAttribute("aria-expanded") === "true";
      menuButton.setAttribute("aria-expanded", String(!isExpanded));
      mobileMenu.classList.toggle("hidden");
    });

    // Close menu when clicking outside
    document.addEventListener("click", (e) => {
      if (
        !menuButton.contains(e.target as Node) &&
        !mobileMenu.contains(e.target as Node) &&
        !mobileMenu.classList.contains("hidden")
      ) {
        menuButton.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
      }
    });

    // Close menu on escape key
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !mobileMenu.classList.contains("hidden")) {
        menuButton.setAttribute("aria-expanded", "false");
        mobileMenu.classList.add("hidden");
        menuButton.focus();
      }
    });
  }
</script>
