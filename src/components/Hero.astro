---
import { Image } from "astro:assets";
import ScrollReveal from "~/components/ScrollReveal.astro";
import screenshotImage from "~/assets/images/screenshot.jpg";

const BASE_URL = import.meta.env.BASE_URL;
---

<div class="w-full border-b border-gray-100 bg-white">
  <section
    class="relative mx-auto max-w-6xl px-6 pb-10 pt-10 sm:px-8 sm:pt-14"
    aria-labelledby="hero-heading"
  >
    <!-- Centered text block -->
    <div class="mx-auto max-w-5xl text-center">
      <ScrollReveal>
        <h1
          id="hero-heading"
          class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl lg:text-6xl"
        >
          Scaling High-Quality
          <span class="decoration-umich-maize decoration-[3px] underline-offset-4 text-umich-maize">Feedback</span> on Student Writing
        </h1>
      </ScrollReveal>

      <ScrollReveal delay={0.08}>
        <p class="mx-auto mt-4 max-w-2xl text-lg text-pretty text-gray-600 sm:text-xl">
          A <strong class="font-semibold text-gray-900">research-backed ecosystem</strong> for feedback provision on open-ended writing assignments — powered by <strong class="font-semibold text-gray-900">AI suggestions</strong> that are aligned with rubrics and human evaluators' cognitive process.
        </p>
      </ScrollReveal>

      <ScrollReveal delay={0.14}>
        <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
          <a
            href={`${BASE_URL}solution/feedbackwriter/`}
            class="bg-umich-blue w-full rounded-lg px-8 py-3 text-center text-sm font-semibold text-white transition hover:bg-umich-blue/90 focus:outline-none sm:w-auto"
          >
            How it works
          </a>
          <a
            href={`${BASE_URL}research/`}
            class="w-full rounded-lg border border-gray-300 px-8 py-3 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-50 focus:outline-none sm:w-auto"
          >
            See the research
          </a>
        </div>
      </ScrollReveal>
    </div>

    <!-- Screenshot — flush to the bottom of the hero -->
    <ScrollReveal delay={0.22}>
      <div class="relative mx-auto mt-10 max-w-6xl">
        <!-- Browser chrome bar -->
        <div class="rounded-t-xl border border-b-0 border-gray-200 bg-gray-100 px-4 py-2.5">
          <div class="flex items-center gap-1.5">
            <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span>
            <span class="h-3 w-3 rounded-full bg-[#febc2e]"></span>
            <span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
            <div class="mx-auto w-48 rounded-md border border-gray-200 bg-white px-3 py-0.5 text-center text-xs text-gray-400">
              FeedbackWriter
            </div>
          </div>
        </div>
        <Image
          src={screenshotImage}
          alt="Screenshot of the FeedbackWriter interface for reviewing student writing."
          width={3532}
          height={1858}
          class="block w-full rounded-b-xl shadow-lg ring-1 ring-gray-200"
        />
      </div>
    </ScrollReveal>
  </section>
</div>
