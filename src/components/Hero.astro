---
import { Image } from "astro:assets";
import ScrollReveal from "~/components/ScrollReveal.astro";
import screenshotImage from "~/assets/images/screenshot.png";

const BASE_URL = import.meta.env.BASE_URL;
---

<section
  class="mx-auto max-w-none px-6 pt-12 pb-16 md:px-8 md:pt-20 md:pb-24 lg:max-w-6xl"
  aria-labelledby="hero-heading"
>
  <div class="mx-auto max-w-4xl text-center">
    <ScrollReveal>
      <h1
        id="hero-heading"
        class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl md:text-6xl lg:text-7xl"
      >
        Feedback that scales, without leaving rubrics or judgment behind
      </h1>
    </ScrollReveal>
    <ScrollReveal delay={0.08}>
      <p class="mt-8 text-lg font-medium text-pretty text-gray-700 sm:text-xl">
        Mentor AI supports <strong class="font-semibold text-gray-900"
          >open-ended writing</strong
        > with <strong class="font-semibold text-gray-900"
          >AI-mediated suggestions</strong
        > that teaching staff review before feedback reaches students, so quality
        and course standards stay in human hands.
      </p>
    </ScrollReveal>
    <ScrollReveal delay={0.14}>
      <div
        class="mt-10 flex flex-col items-stretch justify-center gap-4 sm:flex-row sm:items-center"
      >
        <a
          href={`${BASE_URL}solution/`}
          class="bg-umich-blue ring-umich-blue hover:bg-umich-maize hover:text-umich-blue focus-visible:ring-umich-maize rounded-md px-6 py-3 text-center text-sm font-medium text-white transition hover:ring-2 focus:outline-none focus-visible:ring-2"
        >
          How it works
        </a>
        <a
          href={`${BASE_URL}research/`}
          class="text-umich-blue border-umich-blue hover:bg-umich-blue rounded-md border px-6 py-3 text-center text-sm font-medium transition hover:text-white"
        >
          Research
        </a>
      </div>
    </ScrollReveal>
  </div>
  <ScrollReveal delay={0.2}>
    <Image
      src={screenshotImage}
      alt="Screenshot of the FeedbackWriter interface for reviewing student writing."
      width={2432}
      height={1442}
      class="mt-12 rounded-md bg-gray-50 shadow-lg ring-1 ring-gray-900/10 sm:mt-16"
    />
  </ScrollReveal>
</section>
