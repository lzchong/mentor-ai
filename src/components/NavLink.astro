---
export type NavLinkVariant = "desktop" | "mobile";

interface Props {
  href: string;
  variant: NavLinkVariant;
}

const { href, variant } = Astro.props;

const isMobile = variant === "mobile";
const className = isMobile
  ? "hover:bg-umich-blue/5 hover:text-umich-blue block px-4 py-3 text-gray-700 font-medium transition-colors"
  : "rounded-md px-3 py-2 text-sm font-medium text-gray-600 transition-colors hover:bg-umich-blue/5 hover:text-umich-blue focus:outline-none focus-visible:bg-umich-blue/5";
const isActive = Astro.url.pathname === href;
---

<a
  href={href}
  class={className}
  role={isMobile ? "menuitem" : undefined}
  aria-current={isActive ? "page" : undefined}
>
  <slot />
</a>
