---
export type ScrollRevealDirection = "up" | "down" | "left" | "right";

interface Props {
  delay?: number;
  direction?: ScrollRevealDirection;
}

const { delay = 0, direction = "up" } = Astro.props;

const distance = 16;
const offsets: Record<ScrollRevealDirection, { x: number; y: number }> = {
  up: { x: 0, y: distance },
  down: { x: 0, y: -distance },
  left: { x: distance, y: 0 },
  right: { x: -distance, y: 0 },
};
const { x, y } = offsets[direction];
---

<div
  data-scroll-reveal
  data-delay={delay}
  data-start-x={x}
  data-start-y={y}
  style={`--sr-x:${x}px; --sr-y:${y}px;`}
>
  <slot />
</div>

<script>
  import { animate, inView } from "motion";

  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  inView("[data-scroll-reveal]", (element) => {
    if (!(element instanceof HTMLElement)) return;
    if (element.dataset.revealed === "true") return;

    if (prefersReducedMotion.matches) {
      element.dataset.revealed = "true";
      return;
    }

    const startX = Number(element.dataset.startX) || 0;
    const startY = Number(element.dataset.startY) || 0;
    const delay = Number(element.dataset.delay) || 0;

    animate(
      element,
      {
        opacity: [0, 1],
        x: [startX, 0],
        y: [startY, 0],
      },
      {
        type: "spring",
        stiffness: 70,
        damping: 18,
        mass: 1,
        delay,
      },
    ).then(() => {
      element.dataset.revealed = "true";
    });
  });
</script>

<style>
  [data-scroll-reveal] {
    opacity: 0;
    transform: translate3d(var(--sr-x, 0), var(--sr-y, 0), 0);
    will-change: transform, opacity;
  }

  [data-scroll-reveal][data-revealed="true"] {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    [data-scroll-reveal] {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
</style>
