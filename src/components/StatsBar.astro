---
interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="bg-umich-blue w-full">
  <div class="mx-auto max-w-6xl px-16 py-10">
    <dl
      class="grid grid-cols-1 gap-8 sm:grid-cols-3 sm:divide-x sm:divide-white/20"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col items-center gap-1 text-center sm:px-8">
            <dt class="text-umich-maize text-4xl font-bold tracking-tight lg:text-5xl">
              {stat.value}
            </dt>
            <dd class="text-sm text-white/80">{stat.label}</dd>
          </div>
        ))
      }
    </dl>
  </div>
</div>
