      </ScrollReveal>
      <div class="mx-auto mt-20 max-w-2xl lg:mx-0">
        <ScrollReveal delay={1.0}>
          <h2
            class="text-umich-blue text-3xl font-semibold tracking-tight text-balance sm:text-5xl"
          >
            Join the Mentor AI Team!
          </h2>
        </ScrollReveal>
        <ScrollReveal delay={1.1}>
          <p class="my-6">
            Want to contribute to our mission? Sign up to become part of our
            research team.
          </p>
          <a
            href={`${BASE_URL}signup/`}
            class="bg-umich-blue hover:ring-umich-blue focus-visible:ring-umich-blue hover:text-umich-blue focus-visible:text-umich-blue rounded-md px-3 py-2 leading-none text-white transition hover:bg-white hover:ring-2 focus:outline-none focus-visible:bg-white focus-visible:ring-2"
          >
            Join us!
          </a>
        </ScrollReveal>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
