---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";
import StatsBar from "~/components/StatsBar.astro";

const BASE_URL = import.meta.env.BASE_URL;
---

<Layout
  title="Our Mission | Mentor AI"
  description="Vision and mission behind Mentor AI — enabling timely, high-quality feedback at scale through research-backed AI tools."
>
  <Header />
  <main
    id="main-content"
    role="main"
    class="bg-background flex-1 pb-24 md:pb-40"
  >
    <!-- Hero -->
    <section class="mx-auto max-w-none px-6 md:px-8 lg:max-w-6xl">
      <div class="mx-auto max-w-3xl py-24 text-center sm:py-32 lg:py-48">
        <ScrollReveal>
          <h1
            class="text-umich-blue text-5xl leading-none font-semibold tracking-tight text-balance sm:text-7xl"
          >
            Enabling Timely, High-Quality Feedback at Scale
          </h1>
        </ScrollReveal>
        <ScrollReveal delay={0.1}>
          <p class="mt-8 text-lg font-medium text-pretty text-gray-700 sm:text-xl sm:leading-8">
            We envision a future where every student receives timely,
            high-quality feedback and guidance during and after they practice,
            without increasing the burden on instructors.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={0.16}>
          <a
            href={`${BASE_URL}about/people/`}
            class="mt-8 inline-block text-sm font-semibold text-umich-blue hover:underline"
          >
            Meet the team →
          </a>
        </ScrollReveal>
      </div>
    </section>

    <!-- Impact stats -->
    <div class="mx-auto max-w-none px-6 md:px-8 lg:max-w-6xl">
      <ScrollReveal>
        <h2 class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl">
          Our impact
        </h2>
      </ScrollReveal>
      <ScrollReveal delay={0.06}>
        <div class="mt-6 overflow-hidden rounded-lg">
          <StatsBar
            stats={[
              { value: "1,000+ students", label: "have benefited from the system" },
              { value: "3,500+ essays", label: "received feedback through the system" },
              { value: "d = 0.50", label: "revision quality improvement vs. human-only feedback (Cohen's d)" },
            ]}
          />
        </div>
      </ScrollReveal>
    </div>

    <!-- CTA -->
    <section class="mx-auto max-w-none px-6 py-16 md:px-8 lg:max-w-6xl">
      <ScrollReveal>
        <div class="rounded-2xl bg-gradient-to-br from-umich-blue to-[#002d5e] px-8 py-12 text-center shadow-xl">
          <h2 class="text-2xl font-semibold text-white">Work with us</h2>
          <p class="mx-auto mt-4 max-w-xl text-pretty text-white/80">
            Instructors, departments, and collaborators — tell us about your
            course or research interests.
          </p>
          <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a
              href={`${BASE_URL}signup/`}
              class="bg-umich-maize text-umich-blue rounded-lg px-8 py-3 text-sm font-semibold transition hover:brightness-95 focus:outline-none"
            >
              Join us
            </a>
            <a
              href={`${BASE_URL}about/people/`}
              class="rounded-md border border-white/50 px-8 py-3 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-none"
            >
              Meet the team
            </a>
          </div>
        </div>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
