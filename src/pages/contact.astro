---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";

const BASE_URL = import.meta.env.BASE_URL;

/** Replace with your Google Form URL when ready. */
const CONTACT_FORM_URL = "#contact-form-placeholder";
---

<Layout
  title="Contact | Mentor AI"
  description="Contact the Mentor AI team for questions about research, collaboration, or classroom use."
>
  <Header />
  <main id="main-content" role="main" class="bg-background flex-1">
    <section
      class="mx-auto max-w-none px-6 pt-12 pb-16 md:px-8 md:pt-16 lg:max-w-6xl"
      aria-labelledby="contact-heading"
    >
      <ScrollReveal>
        <h1
          id="contact-heading"
          class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
        >
          Contact us
        </h1>
      </ScrollReveal>
      <ScrollReveal delay={0.06}>
        <p class="mt-6 max-w-2xl text-lg text-pretty text-gray-700">
          Tell us what you would like to discuss. A short Google Form will live
          here; until then you can reach us by email or phone (see footer).
        </p>
      </ScrollReveal>
    </section>

    <section
      class="mx-auto max-w-none border-t border-gray-200/80 px-6 py-16 md:px-8 lg:max-w-6xl"
      aria-labelledby="contact-form-heading"
    >
      <ScrollReveal>
        <h2
          id="contact-form-heading"
          class="text-umich-blue text-xl font-semibold"
        >
          Contact form
        </h2>
      </ScrollReveal>
      <ScrollReveal delay={0.06}>
        <p class="mt-4 max-w-2xl text-pretty text-gray-700">
          Planned fields: what you would like to contact us about; your name;
          best way to reach you (e.g. email or phone). We aim to respond within
          a few business days when possible.
        </p>
      </ScrollReveal>
      <ScrollReveal delay={0.1}>
        <div
          id="contact-form-placeholder"
          class="border-umich-blue/15 mt-8 max-w-xl rounded-lg border border-dashed bg-white p-8 text-center"
        >
          <p class="text-sm font-medium text-gray-600">
            Google Form link not yet configured.
          </p>
          <a
            href={CONTACT_FORM_URL}
            aria-disabled="true"
            class="bg-umich-blue/40 pointer-events-none mt-6 inline-block cursor-not-allowed rounded-md px-6 py-3 text-sm font-medium text-white"
          >
            Open form (coming soon)
          </a>
          <p class="mt-4 text-xs text-gray-500">
            TODO: set <code
              class="rounded bg-gray-100 px-1 py-0.5 text-gray-800"
              >CONTACT_FORM_URL</code
            > in <code class="rounded bg-gray-100 px-1 py-0.5 text-gray-800"
              >contact.astro</code
            >.
          </p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={0.14}>
        <p class="mt-10 text-sm text-gray-600">
          <a
            href={BASE_URL}
            class="text-umich-blue font-medium hover:underline"
          >
            ← Back to home
          </a>
        </p>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
