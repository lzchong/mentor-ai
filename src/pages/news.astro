---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";

const BASE_URL = import.meta.env.BASE_URL;

const items = [
  {
    date: "2026",
    title: "CHI ’26 paper available on arXiv",
    body: "AI-Mediated Feedback Improves Student Revisions: A Randomized Trial with FeedbackWriter in a Large Undergraduate Course. Full text on arXiv.",
    href: `${BASE_URL}research/`,
    linkLabel: "Research page",
  },
  {
    date: "2025",
    title: "AIED 2025 publication",
    body: "Exploring LLM-Generated Feedback for Economics Essays: How Teaching Assistants Evaluate and Envision Its Use, archived on arXiv.",
    href: "https://arxiv.org/html/2505.15596v1",
    linkLabel: "arXiv HTML",
  },
  {
    date: "2025",
    title: "Mentor AI site",
    body: "This public site summarizes our research direction, tools, and how to get involved. Content is kept aligned with published work, with no inflated metrics.",
    href: `${BASE_URL}about/`,
    linkLabel: "About",
  },
];
---

<Layout
  title="News | Mentor AI"
  description="Updates on Mentor AI research, publications, and the public site."
>
  <Header />
  <main
    id="main-content"
    role="main"
    class="bg-background flex-1 pt-12 pb-24 md:pt-20 md:pb-40"
  >
    <section
      class="mx-auto max-w-none px-16 lg:max-w-6xl"
      aria-labelledby="news-heading"
    >
      <ScrollReveal>
        <h1
          id="news-heading"
          class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
        >
          News and updates
        </h1>
      </ScrollReveal>
      <ScrollReveal delay={0.06}>
        <p class="mt-6 max-w-2xl text-lg text-pretty text-gray-700">
          Short announcements tied to publications and this site. We do not list
          speculative milestones or community statistics here.
        </p>
      </ScrollReveal>
      <ul class="mt-14 space-y-12" role="list">
        {
          items.map((item, i) => (
            <li>
              <ScrollReveal delay={0.05 * (i + 1)}>
                <article class="border-umich-blue/10 border-l-umich-maize rounded-lg border-l-4 bg-white py-2 pl-6 shadow-sm">
                  <p class="text-sm font-medium text-gray-500">{item.date}</p>
                  <h2 class="text-umich-blue mt-1 text-xl font-semibold text-pretty">
                    {item.title}
                  </h2>
                  <p class="mt-3 text-pretty text-gray-700">{item.body}</p>
                  <a
                    href={item.href}
                    class="text-umich-blue mt-4 inline-block text-sm font-semibold hover:underline"
                  >
                    {item.linkLabel} →
                  </a>
                </article>
              </ScrollReveal>
            </li>
          ))
        }
      </ul>
    </section>
  </main>
  <Footer />
</Layout>
