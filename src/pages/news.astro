---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ScrollReveal from "../components/ScrollReveal.astro";
---

<Layout
  title="News & Updates | Mentor AI"
  description="Stay up to date with the latest news and updates about Mentor AI."
>
  <Header />
  <main id="main-content" role="main" class="bg-background flex-1">
    <section
      class="mx-auto max-w-none px-6 pt-12 pb-24 md:px-8 md:pt-20 md:pb-40 lg:max-w-6xl"
    >
      <ScrollReveal>
        <h1
          class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
        >
          News & Update
        </h1>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
