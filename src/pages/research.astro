---
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";
import CHIImage from "~/assets/images/research/teaser3.png";
import AIEDImage from "~/assets/images/research/ExploringEcon.png";

const BASE_URL = import.meta.env.BASE_URL;

const chiPaper = {
  title:
    "AI-Mediated Feedback Improves Student Revisions: A Randomized Trial with FeedbackWriter in a Large Undergraduate Course",
  venue: "CHI (ACM Conference on Human Factors in Computing Systems)",
  year: "2026",
  authors: "Xinyi Lu, Kexin Phyllis Ju, Mitchell Dudley, Larissa Sano, Xu Wang",
  img: CHIImage,
  link: "https://arxiv.org/pdf/2602.16820v2",
  summary: "Randomized controlled trial in a large introductory economics course (N = 354): students received either TA-authored feedback or AI-mediated feedback where TAs could adopt, edit, or dismiss FeedbackWriter suggestions on knowledge-intensive essays. 1,366 essays were graded across two assignment cycles.",
  bullets: [
    "Randomized controlled trial in a large introductory economics course (N = 354, 11 TAs, crossover design): students received either TA-authored feedback or AI-mediated feedback where TAs could adopt, edit, or dismiss FeedbackWriter suggestions on knowledge-intensive essays. 1,366 essays were graded across two assignment cycles.",
    "Students in the AI-mediated condition produced significantly higher-quality revised drafts (Cohen’s d = 0.50), roughly equivalent to moving from the 50th to the 70th percentile. Effect sizes grew as TAs adopted more AI constructive suggestions. TAs using FeedbackWriter provided more feedback per essay (10.5 vs. 6.6 units) with greater rubric coverage.",
    "Automated analysis of 6,342 feedback units found AI-mediated feedback scored significantly higher on actionability (89% vs. 76%), promotion of independent learning (93% vs. 82%), and tone & supportiveness (97% vs. 81%). TAs retained 88.7% of AI rubric judgments and adopted 51.3% of AI feedback suggestions. Course post-test scores did not differ significantly between conditions — the benefit is in revision quality, not direct knowledge transmission.",
  ],
};

const aiedPaper = {
  title:
    "Exploring LLM-Generated Feedback for Economics Essays: How Teaching Assistants Evaluate and Envision Its Use",
  venue:
    "AIED (International Conference on Artificial Intelligence in Education)",
  year: "2025",
  authors: "Xinyi Lu, Aditya Mahesh*, Zejia Shen*, Mitchell Dudley, Larissa Sano, Xu Wang",
  img: AIEDImage,
  link: "https://arxiv.org/pdf/2505.15596v1",
  summary: "Formative think-aloud study with 5 teaching assistants evaluating LLM-generated feedback on 20 rubric-guided, knowledge-intensive economics essays — the design study that informed FeedbackWriter's AI pipeline.",
  bullets: [
    "Formative think-aloud study with 5 teaching assistants evaluating LLM-generated feedback on 20 rubric-guided, knowledge-intensive economics essays — the design study that informed FeedbackWriter's AI pipeline.",
    "AI-generated feedback contained more praise, guiding questions, and explanations than historic TA feedback, and was judged more personalized. TAs found suggestions workable when grounded in detailed rubrics; in-text evidence highlights made AI mistakes easy to spot and correct.",
    "Key design insight: decomposing the evaluation pipeline into intermediate steps (highlight → judge → draft) and surfacing each step for inspection was critical for TAs to trust, audit, and selectively adopt AI suggestions without over-reliance.",
  ],
};
---

<Layout
  title="Research | Mentor AI"
  description="Empirical studies of AI-mediated feedback in real undergraduate courses, including a randomized trial with FeedbackWriter (N = 354)."
>
  <Header />
  <main
    id="main-content"
    role="main"
    class="bg-background flex-1 pt-12 pb-24 md:pt-20 md:pb-40"
  >
    <section
      class="mx-auto max-w-none px-16 pb-16 lg:max-w-6xl"
      aria-labelledby="research-hero-heading"
    >
      <ScrollReveal>
        <h1
          id="research-hero-heading"
          class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
        >
          Research in real classrooms
        </h1>
      </ScrollReveal>
      <ScrollReveal delay={0.05}>
        <p class="mt-6 max-w-3xl text-lg text-pretty text-gray-700 sm:text-xl">
          Designing AI-powered systems and interactions to facilitate feedback provision; Understanding the effects on students' writing and learning through randomized controlled trials in real classrooms.
        </p>
      </ScrollReveal>
    </section>
     <section
      class="mx-auto max-w-none p-16 lg:max-w-6xl"
      aria-labelledby="publications-heading"
    >
      <ScrollReveal>
        <h2
          id="publications-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          Key publications
        </h2>
      </ScrollReveal>

      <!-- CHI ‘26 -->
      <ScrollReveal delay={0.05}>
        <article
          class="border-umich-blue/20 mt-10 overflow-hidden rounded-lg border bg-white shadow-sm"
        >
          <div class="grid grid-cols-1 md:grid-cols-[2fr_3fr]">
            <div class="flex items-center justify-center bg-gray-50 p-4">
              <Image
                src={chiPaper.img}
                alt="Teaser figure from the CHI ‘26 FeedbackWriter paper."
                class="h-full w-full object-contain"
              />
            </div>
            <div class="p-8">
              <p class="text-sm font-medium text-gray-500">
                {chiPaper.venue} · {chiPaper.year}
              </p>
              <h3 class="text-umich-blue mt-2 text-xl font-semibold text-pretty">
                {chiPaper.title}
              </h3>
              <p class="mt-1 text-sm text-gray-400">{chiPaper.authors}</p>
              <!-- <p class="mt-4 text-pretty text-gray-700">{chiPaper.summary}</p> -->
              <div class="mt-6 flex flex-wrap gap-3">
                <a
                  href={aiedPaper.link}
                  class="text-umich-blue border-umich-blue hover:bg-umich-blue rounded-md border px-4 py-2 text-sm font-medium transition hover:text-white"
                >
                  Paper
                </a>
              </div>
            </div>
          </div>
        </article>
      </ScrollReveal>

      <!-- AIED ‘25 -->
      <ScrollReveal delay={0.08}>
        <article
          class="border-umich-blue/15 mt-6 overflow-hidden rounded-lg border bg-white shadow-sm"
        >
          <div class="grid grid-cols-1 md:grid-cols-[2fr_3fr]">
            <div class="flex items-center justify-center bg-gray-50 p-4">
              <Image
                src={aiedPaper.img}
                alt="Teaser figure from the AIED ‘25 paper on LLM-generated feedback."
                class="h-full w-full object-contain"
              />
            </div>
            <div class="p-8">
              <p class="text-sm font-medium text-gray-500">
                {aiedPaper.venue} · {aiedPaper.year}
              </p>
              <h3 class="text-umich-blue mt-2 text-lg font-semibold text-pretty">
                {aiedPaper.title}
              </h3>
              <p class="mt-1 text-sm text-gray-400">{aiedPaper.authors}</p>
              <!--<p class="mt-4 text-pretty text-gray-700">{aiedPaper.summary}</p> -->
              <div class="mt-6 flex flex-wrap gap-3">
                <a
                  href={aiedPaper.link}
                  class="text-umich-blue border-umich-blue hover:bg-umich-blue rounded-md border px-4 py-2 text-sm font-medium transition hover:text-white"
                >
                  Paper
                </a>
              </div>
            </div>
          </div>
        </article>
      </ScrollReveal>
    </section>
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 bg-white/40 p-16 lg:max-w-6xl"
      aria-labelledby="findings-heading"
    >
      <ScrollReveal>
        <h2
          id="findings-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          Key findings at a glance
        </h2>
      </ScrollReveal>
      <ul class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-2" role="list">
        <li class="flex items-stretch">
          <ScrollReveal delay={0.05}>
            <article
              class="border-umich-blue/15 h-full rounded-lg border bg-white p-6 shadow-sm"
            >
              <div class="text-umich-maize text-2xl font-bold">50th → 70th percentile</div>
              <h3 class="text-umich-blue mt-1 text-lg font-semibold">
                Higher-quality revisions
              </h3>
              <p class="mt-3 text-pretty text-gray-700">
                In the CHI ‘26 RCT (n=354), AI-mediated feedback through FeedbackWriter was associated with <strong>significantly higher-quality revisions</strong> versus human-only TA feedback (Cohen’s d = 0.50). Effects grew as TAs adopted more AI constructive suggestions.
              </p>
            </article>
          </ScrollReveal>
        </li>
        <li class="flex items-stretch">
          <ScrollReveal delay={0.1}>
            <article
              class="border-umich-blue/15 h-full rounded-lg border bg-white p-6 shadow-sm"
            >
              <div class="text-umich-maize text-2xl font-bold">↑ Feedback quality</div>
              <h3 class="text-umich-blue mt-1 text-lg font-semibold">
                More effective feedback properties
              </h3>
              <p class="mt-3 text-pretty text-gray-700">
                Automated analysis of 6,342 feedback units found AI-mediated feedback scored significantly higher on actionability (89% vs 76%), promotion of independent learning (93% vs 82%), and tone &amp; supportiveness (97% vs 81%).
              </p>
            </article>
          </ScrollReveal>
        </li>
        <li class="flex items-stretch">
          <ScrollReveal delay={0.15}>
            <article
              class="border-umich-blue/15 h-full rounded-lg border bg-white p-6 shadow-sm"
            >
              <div class="text-umich-maize text-2xl font-bold">88.7%</div>
              <h3 class="text-umich-blue mt-1 text-lg font-semibold">
                AI–TA judgment agreement
              </h3>
              <p class="mt-3 text-pretty text-gray-700">
                TAs retained 88.7% of AI rubric judgments and 51.3% of the feedback are based on AI feedback suggestions. When they disagreed, they found AI mistakes easy to correct within the interface.
              </p>
            </article>
          </ScrollReveal>
        <li class="flex items-stretch">
          <ScrollReveal delay={0.2}>
            <article
              class="border-umich-blue/15 h-full rounded-lg border bg-white p-6 shadow-sm"
            >
              <div class="text-umich-maize text-2xl font-bold">↑ Consistency</div>
              <h3 class="text-umich-blue mt-1 text-lg font-semibold">
                Greater inter-rater consistency
              </h3>
              <p class="mt-3 text-pretty text-gray-700">
                TAs in the FeedbackWriter condition exhibited significantly lower inter-rater variance than those in the baseline condition, suggesting AI assistance helps calibrate rubric interpretation across graders.
              </p>
            </article>
          </ScrollReveal>
        </li>
      </ul>
    </section>

