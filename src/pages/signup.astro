---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";

const JOIN_FORM_URL =
  "https://docs.google.com/forms/d/e/1FAIpQLSfBiu26vT-uLbt3PHeUjQ_20ui6VYkxgPt1mT5VSVRiQ4g3ZA/viewform";
const JOIN_FORM_EMBED_URL = `${JOIN_FORM_URL}?embedded=true`;

const BASE_URL = import.meta.env.BASE_URL;
---

<Layout
  title="Join us | Mentor AI"
  description="Partner with us on AI-mediated feedback in real courses. Instructors, departments, and researchers welcome."
>
  <Header />
  <main
    id="main-content"
    role="main"
    class="bg-background flex-1 pt-12 pb-24 md:pt-20 md:pb-40"
  >
    <!-- Hero -->
    <section
      class="mx-auto max-w-none px-8 pb-16 lg:max-w-6xl"
      aria-labelledby="join-hero-heading"
    >
      <div class="mx-auto max-w-5xl text-center">
        <ScrollReveal>
          <h1
            id="join-hero-heading"
            class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
          >
            Bring evidence-backed AI feedback to your course, or collaborate to advance it
          </h1>
        </ScrollReveal>
        <ScrollReveal delay={0.08}>
          <p class="mt-6 text-lg text-pretty text-gray-700 sm:text-xl">
            Our randomized trial (N&nbsp;=&nbsp;354) showed that AI-mediated feedback authored with FeedbackWriter led to significantly higher-quality student writings. We're looking for instructors to bring the rubric-grounded, AI-mediated feedback into more classrooms, and researchers to collaborate.
          </p>
        </ScrollReveal>
      </div>
    </section>

    <!-- Audience cards -->
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 px-8 py-16 lg:max-w-6xl"
      aria-labelledby="who-heading"
    >
      <ScrollReveal>
        <h2
          id="who-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight"
        >
          Who this is for
        </h2>
      </ScrollReveal>
      <ul class="mt-8 grid gap-6 lg:grid-cols-2" role="list">
        <!-- Instructor card -->
        <li>
          <ScrollReveal delay={0.06}>
            <div class="h-full rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
              <div class="flex items-center gap-2">
                <span class="bg-umich-blue/10 text-umich-blue rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wide">Instructor / Department Leader</span>
              </div>
              <h3 class="text-umich-blue mt-4 text-xl font-semibold">Deploy FeedbackWriter in your course</h3>
              <p class="mt-3 text-gray-600">
                Are you teaching a course with writing assignments and want to give students higher-quality feedback?
              </p>

              <h4 class="mt-5 text-sm font-semibold text-gray-800">What you get</h4>
              <ul class="mt-2 space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">High-quality feedback for your students</strong> — TAs using FeedbackWriter showed significantly lower inter-rater variance and higher-quality feedback in our trial, which lead to significantly higher quality revised writings.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">An deployed effective tool with RCT evidence</strong> — FeedbackWriter has been evaluated in a published RCT; you're not beta-testing an experiment.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">Human in the loop, always</strong> — TAs can adopt, edit, or dismiss every AI suggestion before it reaches a student. Nothing is automated.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">System setup</strong> — the system can be connected to existing Learning Management Platforms such as Canvas. We configure the system for your assignment for you and you run your course as usual.</span>
                </li>
              </ul>

              <div class="mt-6 rounded-lg border border-umich-blue/15 bg-umich-blue/5 px-4 py-3 text-sm text-umich-blue">
                Deployed and studied in a large introductory economics course at the University of Michigan — 354 students, 11 TAs, 1,366 essays graded.
              </div>
            </div>
          </ScrollReveal>
        </li>

        <!-- Researcher card -->
        <li>
          <ScrollReveal delay={0.1}>
            <div class="h-full rounded-xl border border-gray-200 bg-white p-8 shadow-sm">
              <div class="flex items-center gap-2">
                <span class="bg-umich-maize/20 text-umich-blue rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wide">Researcher / Collaborator</span>
              </div>
              <h3 class="text-umich-blue mt-4 text-xl font-semibold">Collaborate to scale high-quality feedback</h3>
              <p class="mt-3 text-gray-600">
                Interested in studying how we can enable scalable and high-quality feedback, with evidence from real classrooms?
              </p>

              <h4 class="mt-5 text-sm font-semibold text-gray-800">What you get</h4>
              <ul class="mt-2 space-y-2 text-sm text-gray-700">
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">Access to a working deployed system</strong> — FeedbackWriter is live, not a prototype. Published methods from CHI '26 and AIED '25 provide a reproducible starting point.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">Collaborate on scaling high-quality feedback</strong> — we actively seek collaborators to explore open questions and extend findings to new disciplines or feedback modalities.</span>
                </li>
                <li class="flex items-start gap-2">
                  <span class="text-umich-maize mt-0.5 shrink-0 font-bold">✓</span>
                  <span><strong class="font-semibold">An active research community</strong> — connect with an interdisciplinary team spanning CS, economics, and writing pedagogy who are building the evidence base together.</span>
                </li>
              </ul>

              <div class="mt-6 rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 text-sm text-gray-600">
                Grounded in two peer-reviewed publications: <a href="https://arxiv.org/pdf/2602.16820v2" class="text-umich-blue font-medium hover:underline" target="_blank" rel="noopener noreferrer">CHI '26 RCT</a> and <a href="https://arxiv.org/pdf/2505.15596v1" class="text-umich-blue font-medium hover:underline" target="_blank" rel="noopener noreferrer">AIED '25 qualitative study</a>.
              </div>
            </div>
          </ScrollReveal>
        </li>
      </ul>
    </section>


    <!-- What to expect -->
