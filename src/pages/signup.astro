    <section
      class="mx-auto max-w-none border-t border-gray-200/80 bg-gray-50 px-8 py-16 lg:max-w-6xl"
      aria-labelledby="process-heading"
    >
      <ScrollReveal>
        <h2
          id="process-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight"
        >
          What to expect
        </h2>
        <p class="mt-2 text-gray-500">A straightforward process, grounded in fit.</p>
      </ScrollReveal>
      <ol class="mt-8 grid gap-5 sm:grid-cols-3" role="list">
        <ScrollReveal delay={0.05}>
          <li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <span class="bg-umich-blue text-umich-maize mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold">1</span>
            <div>
              <h3 class="text-umich-blue font-semibold">Tell us about your course</h3>
              <p class="mt-1 text-sm text-gray-600">Fill out the form below (about 2 minutes). Describe your assignment type, course size, and what you're hoping to improve.</p>
            </div>
          </li>
        </ScrollReveal>
        <ScrollReveal delay={0.1}>
          <li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <span class="bg-umich-blue text-umich-maize mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold">2</span>
            <div>
              <h3 class="text-umich-blue font-semibold">We follow up</h3>
              <p class="mt-1 text-sm text-gray-600">Within a few business days we'll reach out to schedule a conversation and see whether there's a good fit for your context and ours.</p>
            </div>
          </li>
        </ScrollReveal>
        <ScrollReveal delay={0.15}>
          <li class="flex gap-4 rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <span class="bg-umich-blue text-umich-maize mt-0.5 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-sm font-bold">3</span>
            <div>
              <h3 class="text-umich-blue font-semibold">We set up together</h3>
              <p class="mt-1 text-sm text-gray-600">If there's a match, we handle rubric configuration and TA onboarding. You run your course as usual — we support you through the first deployment.</p>
            </div>
          </li>
        </ScrollReveal>
      </ol>
    </section>
-->
    <!-- Form -->
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 bg-white/50 px-8 py-16 lg:max-w-6xl"
      aria-labelledby="form-heading"
    >
      <!-- Trust strip -->
      <ScrollReveal>
        <div class="mb-10 flex flex-wrap justify-center gap-4 text-sm">
          <span class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-1.5 text-gray-600 shadow-sm">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><path d="M7 1L8.8 5.2L13.5 5.7L10 9L10.9 13.5L7 11.2L3.1 13.5L4 9L0.5 5.7L5.2 5.2L7 1Z" fill="#00274c"/></svg>
            Peer-reviewed at CHI '26
          </span>
          <span class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-1.5 text-gray-600 shadow-sm">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><rect x="1" y="3" width="12" height="9" rx="1.5" stroke="#00274c" stroke-width="1.4"/><path d="M4 3V2.5C4 1.67 4.67 1 5.5 1H8.5C9.33 1 10 1.67 10 2.5V3" stroke="#00274c" stroke-width="1.4"/></svg>
            University of Michigan research team
          </span>
          <span class="flex items-center gap-1.5 rounded-full border border-gray-200 bg-white px-4 py-1.5 text-gray-600 shadow-sm">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true"><circle cx="7" cy="7" r="5.5" stroke="#00274c" stroke-width="1.4"/><path d="M5 7L6.5 8.5L9.5 5.5" stroke="#00274c" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Human-in-the-loop — TAs always have full control
          </span>
        </div>
      </ScrollReveal>

      <ScrollReveal delay={0.05}>
        <h2
          id="form-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight"
        >
          Tell us about your course or research interest
        </h2>
      </ScrollReveal>
      <ScrollReveal delay={0.1}>
        <div class="mt-8">
          <iframe
            src={JOIN_FORM_EMBED_URL}
            title="Mentor AI collaboration interest form"
            class="h-[900px] w-full rounded-md"
            loading="lazy"
          >
            Loading…
          </iframe>
          <p class="mt-4 text-sm text-gray-600">
            If the form does not load, open it in a new tab:
            <a
              href={JOIN_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-umich-blue ml-1 font-medium underline underline-offset-2 hover:no-underline"
            >
              Open form
            </a>
          </p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={0.14}>
        <p class="mt-6 text-sm text-gray-500">
          Not sure if there's a fit? Fill out the form anyway — we'll let you know.
        </p>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
