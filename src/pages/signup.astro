---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";

const JOIN_FORM_URL =
  "https://docs.google.com/forms/d/e/1FAIpQLSfBiu26vT-uLbt3PHeUjQ_20ui6VYkxgPt1mT5VSVRiQ4g3ZA/viewform";
const JOIN_FORM_EMBED_URL = `${JOIN_FORM_URL}?embedded=true`;
---

<Layout
  title="Join us | Mentor AI"
  description="Partner with us on AI-mediated feedback in real courses. Instructors, departments, and researchers welcome."
>
  <Header />
  <main
    id="main-content"
    role="main"
    class="bg-background flex-1 pt-12 pb-24 md:pt-20 md:pb-40"
  >
    <section
      class="mx-auto max-w-none px-16 pb-16 lg:max-w-6xl"
      aria-labelledby="join-hero-heading"
    >
      <div class="mx-auto max-w-3xl text-center">
        <ScrollReveal>
          <h1
            id="join-hero-heading"
            class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
          >
            Join us in improving feedback in education
          </h1>
        </ScrollReveal>
        <ScrollReveal delay={0.08}>
          <p class="mt-6 text-lg text-pretty text-gray-700 sm:text-xl">
            We work with instructors and instructional leaders to bring
            rubric-grounded, human-reviewed AI feedback into real classrooms,
            and to study what works.
          </p>
        </ScrollReveal>
      </div>
    </section>
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 p-16 lg:max-w-6xl"
      aria-labelledby="who-heading"
    >
      <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-2">
        <div>
          <ScrollReveal>
            <h2
              id="who-heading"
              class="text-umich-blue text-2xl font-semibold tracking-tight"
            >
              Who this is for
            </h2>
          </ScrollReveal>
          <ScrollReveal delay={0.06}>
            <ul class="mt-6 list-disc space-y-3 pl-5 text-pretty text-gray-700">
              <li>
                <strong class="text-gray-900">Instructors</strong> teaching writing-intensive
                or open-ended assignments who care about rubric alignment.
              </li>
              <li>
                <strong class="text-gray-900">Departments and programs</strong> exploring
                responsible AI support for grading and feedback at scale.
              </li>
              <li>
                <strong class="text-gray-900">Researchers and partners</strong> interested
                in empirical work on human-AI feedback workflows.
              </li>
            </ul>
          </ScrollReveal>
        </div>
        <div>
          <ScrollReveal delay={0.1}>
            <h2 class="text-umich-blue text-2xl font-semibold tracking-tight">
              What you can expect
            </h2>
            <ul class="mt-6 list-disc space-y-3 pl-5 text-pretty text-gray-700">
              <li>
                Conversations grounded in our published trials and design
                experience, not a sales pitch.
              </li>
              <li>
                Where there is a fit, possible pilots or collaborations shaped
                around your course goals and constraints.
              </li>
              <li>
                Clear boundaries: we do not promise outcomes beyond what the
                research supports.
              </li>
            </ul>
          </ScrollReveal>
        </div>
      </div>
    </section>
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 bg-white/50 p-16 lg:max-w-6xl"
      aria-labelledby="form-heading"
    >
      <ScrollReveal>
        <h2
          id="form-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight"
        >
          Apply or express interest
        </h2>
      </ScrollReveal>
      <ScrollReveal delay={0.1}>
        <div class="mt-8">
          <iframe
            src={JOIN_FORM_EMBED_URL}
            title="Mentor AI collaboration interest form"
            class="h-[900px] w-full rounded-md"
            loading="lazy"
          >
            Loading…
          </iframe>
          <p class="mt-4 text-sm text-gray-600">
            If the form does not load, open it in a new tab:
            <a
              href={JOIN_FORM_URL}
              target="_blank"
              rel="noopener noreferrer"
              class="text-umich-blue ml-1 font-medium underline underline-offset-2 hover:no-underline"
            >
              Open form
            </a>
          </p>
        </div>
      </ScrollReveal>
      <ScrollReveal delay={0.14}>
        <h3 class="text-umich-blue mt-12 text-lg font-semibold">
          What happens next
        </h3>
        <ol
          class="mt-4 max-w-2xl list-decimal space-y-2 pl-5 text-pretty text-gray-700"
        >
          <li>We review submissions as capacity allows.</li>
          <li>
            If there is a match, we follow up by email with next steps or
            questions.
          </li>
          <li>
            We typically reply within a few business days when we can engage;
            silence may mean we are at capacity. Feel free to try again later.
          </li>
        </ol>
      </ScrollReveal>
      <ScrollReveal delay={0.18}>
        <p class="mt-8 text-sm text-gray-700">
          General questions? Contact us via email or phone.
        </p>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
