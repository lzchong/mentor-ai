---
import { Image } from "astro:assets";
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";
import pipelineImage from "~/assets/images/research/pipeline.png";

const BASE_URL = import.meta.env.BASE_URL;

const faq = [
  {
    q: "Do students see raw AI output?",
    a: "In FeedbackWriter, teaching assistants receive AI suggestions and decide what to adopt, edit, or dismiss before feedback reaches students. The final message reflects human judgment aligned with your rubric.",
  },
  {
    q: "Who owns the rubric and assignment design?",
    a: "Instructors define assignments and rubrics. That structure grounds both human grading and AI suggestions so feedback stays faithful to course goals.",
  },
  {
    q: "What is DraftMentors?",
    a: "DraftMentors provides structured student support on open-ended responses, aligned with instructor expectations. It complements the instructor-and-TA workflow rather than replacing it.",
  },
  {
    q: "Is this only for economics?",
    a: "Our published studies center on knowledge-intensive writing in an introductory economics course. We are now exploring how the same rubric-grounded, human-in-the-loop workflow can transfer to other disciplines with open-ended prompts.",
  },
  {
    q: "What evidence supports the approach?",
    a: "A randomized trial (N = 354) found significantly higher-quality revisions with AI-mediated feedback via FeedbackWriter versus human-only feedback; see our Research page for full citations and nuance (including post-test results).",
  },
  {
    q: "How can my department get involved?",
    a: "Use the Join page to tell us about your course or collaboration interest. We will follow up when we can.",
  },
];
---

<Layout
  title="Solution | Mentor AI"
  description="FeedbackWriter for instructors and TAs; DraftMentors for students. AI suggestions with human judgment and rubric alignment."
>
  <Header />
  <main id="main-content" role="main" class="bg-background flex-1 pt-12 pb-24 md:pt-20 md:pb-40">
    <section
      class="mx-auto max-w-none px-16 pb-16 lg:max-w-6xl"
      aria-labelledby="solution-hero-heading"
    >
      <div class="mx-auto max-w-3xl text-center">
        <ScrollReveal>
          <h1
            id="solution-hero-heading"
            class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
          >
            Solutions for every role in the feedback process
          </h1>
        </ScrollReveal>
        <ScrollReveal delay={0.06}>
          <p class="mt-6 text-lg text-pretty text-gray-700 sm:text-xl">
            High-quality feedback on open-ended writing takes time. We combine
            <strong class="font-semibold text-gray-900"
              >AI-generated suggestions</strong
            > with <strong class="font-semibold text-gray-900"
              >human review</strong
            > so suggestions stay accurate, actionable, and aligned with your rubrics.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={0.12}>
          <div class="mt-10 flex flex-wrap justify-center gap-4">
            <a
              href={`${BASE_URL}research/`}
              class="bg-umich-blue ring-umich-blue hover:bg-umich-maize hover:text-umich-blue focus-visible:ring-umich-maize rounded-md px-5 py-2.5 text-sm font-medium text-white transition hover:ring-2 focus:outline-none focus-visible:ring-2"
            >
              Read the research
            </a>
            <a
              href={`${BASE_URL}signup/`}
              class="text-umich-blue border-umich-blue hover:bg-umich-blue rounded-md border px-5 py-2.5 text-sm font-medium transition hover:text-white"
            >
              Join us
            </a>
          </div>
        </ScrollReveal>
      </div>
      <ScrollReveal delay={0.15}>
        <figure class="mx-auto mt-16 max-w-4xl">
          <Image
            src={pipelineImage}
            alt="Workflow: student submits an essay; the system generates rubric-based AI suggestions; the TA reviews and sends feedback; the student revises."
            width={3122}
            height={618}
            class="w-full rounded-md bg-white shadow-md ring-1 ring-gray-900/10"
          />
          <figcaption class="mt-3 text-center text-sm text-gray-500">
            Instructor-defined rubrics and TA review connect AI suggestions to
            what students actually receive.
          </figcaption>
        </figure>
      </ScrollReveal>
    </section>
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 bg-white/50 p-16 lg:max-w-6xl"
      aria-labelledby="roles-heading"
    >
      <ScrollReveal>
        <h2
          id="roles-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          By role
        </h2>
      </ScrollReveal>
      <ul class="mt-12 grid gap-10 lg:grid-cols-3" role="list">
        <li class="flex items-stretch">
          <ScrollReveal delay={0.05}>
            <article
              class="h-full rounded-lg border border-gray-200 bg-white p-8 shadow-sm"
            >
              <h3 class="text-umich-blue text-xl font-semibold">Instructors</h3>
              <p class="mt-4 text-pretty text-gray-700">
                Create assignments and define rubrics that express what
                excellent work looks like. Clear rubrics anchor both human
                grading and AI suggestions so feedback reflects your learning
                goals.
              </p>
              <p class="mt-4 text-sm text-gray-600">
                <strong class="text-gray-800">Outcome:</strong> Designed to support
                consistent, rubric-aligned feedback across sections and TAs.
              </p>
            </article>
          </ScrollReveal>
        </li>
        <li class="flex items-stretch">
          <ScrollReveal delay={0.1}>
            <article
              class="h-full rounded-lg border border-gray-200 bg-white p-8 shadow-sm"
            >
              <h3 class="text-umich-blue text-xl font-semibold">
                TAs and graders
              </h3>
              <p class="mt-4 text-pretty text-gray-700">
                Use <strong class="font-medium text-gray-900"
                  >FeedbackWriter</strong
                > to review AI-generated suggestions, correct mistakes, and align
                comments with the rubric before or as feedback reaches students.
              </p>
              <p class="mt-4 text-sm text-gray-600">
                <strong class="text-gray-800">Outcome:</strong> Designed to reduce
                repetitive drafting work, freeing more time for rubric-aligned judgment
                where it matters.
              </p>
            </article>
          </ScrollReveal>
        </li>
        <li class="flex items-stretch">
          <ScrollReveal delay={0.15}>
            <article
              class="h-full rounded-lg border border-gray-200 bg-white p-8 shadow-sm"
            >
              <h3 class="text-umich-blue text-xl font-semibold">Students</h3>
              <p class="mt-4 text-pretty text-gray-700">
                <strong class="font-medium text-gray-900">DraftMentors</strong> offers
                structured student support on open-ended responses, informed by instructor
                and course expectations.
              </p>
              <p class="mt-4 text-sm text-gray-600">
                <strong class="text-gray-800">Outcome:</strong> Students receive actionable
                guidance while staying oriented to your requirements.
              </p>
            </article>
          </ScrollReveal>
        </li>
      </ul>
    </section>
    <section
      class="mx-auto max-w-none p-16 lg:max-w-6xl"
      aria-labelledby="workflow-heading"
    >
      <ScrollReveal>
        <h2
          id="workflow-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          How it fits together
        </h2>
      </ScrollReveal>
      <ScrollReveal delay={0.05}>
        <ol
          class="mt-10 max-w-3xl list-decimal space-y-4 pl-6 text-pretty text-gray-700"
        >
          <li>
            <strong class="text-gray-900">Setup:</strong> Instructors publish prompts
            and rubrics.
          </li>
          <li>
            <strong class="text-gray-900">Drafting:</strong> Students produce open-ended
            work (essays, short answers).
          </li>
          <li>
            <strong class="text-gray-900">TA review:</strong> FeedbackWriter proposes
            rubric-grounded suggestions; TAs adopt, edit, or replace them.
          </li>
          <li>
            <strong class="text-gray-900">Revision:</strong> Students revise from
            TA-authored feedback; DraftMentors can support that loop where deployed.
          </li>
        </ol>
        <p class="mt-8 max-w-3xl text-pretty text-gray-700">
          The platform-level story is one continuous loop: <strong
            class="font-medium text-gray-900">setup</strong
          >, <strong class="font-medium text-gray-900"
            >human-in-the-loop grading</strong
          >, and <strong class="font-medium text-gray-900"
            >student support</strong
          >, with AI accelerating drafts that humans still control.
        </p>
      </ScrollReveal>
    </section>
    <section
      class="mx-auto max-w-none border-t border-gray-200/80 bg-white/50 p-16 lg:max-w-6xl"
      aria-labelledby="faq-heading"
    >
      <ScrollReveal>
        <h2
          id="faq-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          Frequently asked questions
        </h2>
      </ScrollReveal>
      <dl class="mt-10 max-w-3xl space-y-8">
        {
          faq.map((item, i) => (
            <ScrollReveal delay={0.03 * (i + 1)}>
              <div>
                <dt class="text-umich-blue text-lg font-semibold">{item.q}</dt>
                <dd class="mt-2 text-pretty text-gray-700">{item.a}</dd>
              </div>
            </ScrollReveal>
          ))
        }
      </dl>
    </section>
    <section
      class="mx-auto max-w-none p-16 lg:max-w-6xl"
      aria-labelledby="solution-cta-heading"
    >
      <ScrollReveal>
        <div
          class="border-umich-blue/20 rounded-lg border bg-white px-8 py-12 text-center shadow-sm"
        >
          <h2
            id="solution-cta-heading"
            class="text-umich-blue text-2xl font-semibold"
          >
            Work with us
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-pretty text-gray-700">
            If you are an instructor or instructional leader interested in
            rubric-grounded, human-reviewed AI feedback, we would like to hear
            from you.
          </p>
          <a
            href={`${BASE_URL}signup/`}
            class="bg-umich-blue ring-umich-blue hover:bg-umich-maize hover:text-umich-blue focus-visible:ring-umich-maize mt-8 inline-block rounded-md px-6 py-3 text-sm font-medium text-white transition hover:ring-2 focus:outline-none focus-visible:ring-2"
          >
            Get in touch
          </a>
        </div>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
