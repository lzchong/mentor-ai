---
import Layout from "~/layouts/Layout.astro";
import Footer from "~/components/Footer.astro";
import Header from "~/components/Header.astro";
import ScrollReveal from "~/components/ScrollReveal.astro";
import AccordionFAQ from "~/components/AccordionFAQ.astro";

const BASE_URL = import.meta.env.BASE_URL;

const faq = [
  {
    q: "Who owns the rubric and assignment design?",
    a: "Instructors define assignments and rubrics. That structure grounds both human grading and AI suggestions so feedback stays faithful to course goals.",
  },
  {
    q: "Is this only for economics?",
    a: "Our published studies center on knowledge-intensive writing in an introductory economics course. We are now exploring how the same rubric-grounded, human-in-the-loop workflow can transfer to other disciplines with open-ended prompts.",
  },
];

const features = [
  {
    title: "Assignment & rubric design",
    desc: "Define prompts and rubric criteria that ground all AI suggestions and TA grading, ensuring feedback is always faithful to your course goals.",
  },
  {
    title: "Grade distribution monitoring",
    desc: "See class-wide performance at a glance and track how grades shift across assignments as rubrics are refined.",
  },
  {
    title: "Student challenge identification",
    desc: "Surface common mistakes and recurring misconceptions from FeedbackWriter grading data so you know exactly where students are struggling.",
  },
  {
    title: "Rubric refinement loop",
    desc: "Use patterns from graded essays and student interactions to improve rubrics for future assignments — closing the loop between teaching and assessment.",
  },
  {
    title: "TA oversight",
    desc: "Monitor grader consistency across sections to ensure rubric alignment holds at scale, regardless of how many TAs are involved.",
  },
];
---

<Layout
  title="Instructor Dashboard | Mentor AI"
  description="The Instructor Dashboard gives educators full visibility over the feedback ecosystem — from assignment design to class-wide analytics and rubric refinement."
>
  <Header />
  <div class="border-b border-amber-200 bg-amber-50 px-6 py-3 text-center text-sm font-medium text-amber-800">
    🚧 This tool is in development — coming soon. <a href={`${import.meta.env.BASE_URL}signup/`} class="underline hover:no-underline">Join the waitlist</a> to stay updated.
  </div>
  <main
    id="main-content"
    role="main"
    class="bg-background flex-1 pb-24 md:pb-40"
  >
    <!-- Hero -->
    <div class="w-full bg-gradient-to-br from-umich-blue via-[#002d5e] to-[#001830]">
      <section class="mx-auto max-w-6xl px-8 pb-20 pt-14" aria-labelledby="id-heading">
        <ScrollReveal>
          <a
            href={`${BASE_URL}solution/`}
            class="inline-flex items-center gap-1 text-sm text-white/50 transition hover:text-white/80"
          >
            ← Solution Overview
          </a>
        </ScrollReveal>
        <div class="mt-6 grid gap-12 lg:grid-cols-2 lg:items-center">
          <div>
            <ScrollReveal delay={0.04}>
              <span class="bg-umich-maize text-umich-blue inline-block rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wide">
                Instructor Dashboard
              </span>
              <h1
                id="id-heading"
                class="mt-4 text-4xl font-semibold tracking-tight text-balance text-white sm:text-5xl"
              >
                Full Visibility Over Your Feedback Ecosystem
              </h1>
              <p class="mt-5 text-lg text-white/75">
                Design assignments, track class-wide performance, identify
                where students struggle, and continuously refine your
                rubrics — all from one place.
              </p>
            </ScrollReveal>
            <ScrollReveal delay={0.1}>
              <div class="mt-8 flex flex-wrap gap-3">
                <a
                  href={`${BASE_URL}signup/`}
                  class="bg-umich-maize text-umich-blue rounded-lg px-5 py-2.5 text-sm font-semibold transition hover:brightness-95 focus:outline-none"
                >
                  Get started
                </a>
                <a
                  href={`${BASE_URL}research/`}
                  class="rounded-lg border border-white/25 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-white/10 focus:outline-none"
                >
                  See the research
                </a>
              </div>
            </ScrollReveal>
          </div>
          <!-- Feature chips in place of screenshot -->
          <ScrollReveal delay={0.12}>
            <div class="grid grid-cols-1 gap-3">
              {
                features.map((f) => (
                  <div class="flex items-start gap-3 rounded-xl border border-white/10 bg-white/8 px-5 py-4">
                    <span class="mt-0.5 text-umich-maize text-lg font-bold shrink-0">✓</span>
                    <div>
                      <p class="text-sm font-semibold text-white">{f.title}</p>
                      <p class="mt-0.5 text-xs text-white/60">{f.desc}</p>
                    </div>
                  </div>
                ))
              }
            </div>
          </ScrollReveal>
        </div>
      </section>
    </div>

    <!-- Features detail -->
    <section
      class="mx-auto max-w-none border-t border-gray-100 bg-white p-16 lg:max-w-6xl"
      aria-labelledby="id-features-heading"
    >
      <ScrollReveal>
        <h2
          id="id-features-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          What you can do
        </h2>
      </ScrollReveal>
      <ul class="mt-10 grid gap-6 sm:grid-cols-2" role="list">
        {
          features.map((f, i) => (
            <li>
              <ScrollReveal delay={0.05 * (i + 1)}>
                <div class="h-full rounded-xl border border-gray-100 bg-white p-6 shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
                  <h3 class="text-umich-blue font-semibold">{f.title}</h3>
                  <p class="mt-2 text-sm text-gray-600">{f.desc}</p>
                </div>
              </ScrollReveal>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Ecosystem data loop -->
    <section
      class="mx-auto max-w-none border-t border-gray-100 p-16 lg:max-w-6xl"
      aria-labelledby="loop-heading"
    >
      <ScrollReveal>
        <h2
          id="loop-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          The instructor at the center of the loop
        </h2>
        <p class="mt-4 max-w-3xl text-gray-600">
          The Instructor Dashboard isn't just for setup. Data from both tools
          flows back to you — helping you see where the curriculum is working
          and where students need more support.
        </p>
      </ScrollReveal>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        <ScrollReveal delay={0.06}>
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="bg-umich-blue/10 text-umich-blue rounded-full px-2.5 py-0.5 text-xs font-semibold">From FeedbackWriter</span>
            </div>
            <p class="mt-3 text-sm text-gray-600">
              Grading patterns and TA feedback data reveal which rubric criteria
              students consistently miss, which sections have grading
              inconsistencies, and where rubric language needs clarification.
            </p>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={0.1}>
          <div class="rounded-xl border border-gray-100 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-2">
              <span class="bg-umich-maize/20 text-umich-blue rounded-full px-2.5 py-0.5 text-xs font-semibold">From DraftMentors</span>
            </div>
            <p class="mt-3 text-sm text-gray-600">
              Student interaction data shows what questions students ask while
              revising, which aspects of assignments they find unclear, and
              where pre-submission support is most needed.
            </p>
          </div>
        </ScrollReveal>
      </div>
      <ScrollReveal delay={0.14}>
        <div class="mt-6 rounded-xl border border-umich-blue/15 bg-umich-blue/5 px-6 py-4">
          <p class="text-sm font-semibold text-umich-blue">Together, this makes your rubrics better over time.</p>
          <p class="mt-1 text-sm text-gray-600">
            Each grading cycle gives you more signal about what works and what
            doesn't — turning the Instructor Dashboard into a continuous
            improvement tool, not just an administrative panel.
          </p>
        </div>
      </ScrollReveal>
    </section>

    <!-- FAQ -->
    <section
      class="mx-auto max-w-none border-t border-gray-100 bg-white p-16 lg:max-w-6xl"
      aria-labelledby="id-faq-heading"
    >
      <ScrollReveal>
        <h2
          id="id-faq-heading"
          class="text-umich-blue text-2xl font-semibold tracking-tight sm:text-3xl"
        >
          Frequently asked questions
        </h2>
      </ScrollReveal>
      <AccordionFAQ items={faq} />
    </section>

    <!-- Related tools -->
    <section
      class="mx-auto max-w-none border-t border-gray-100 bg-white px-8 py-12 lg:max-w-6xl"
      aria-labelledby="id-related-heading"
    >
      <ScrollReveal>
        <h2 id="id-related-heading" class="text-umich-blue text-lg font-semibold">
          Also in the Mentor AI ecosystem
        </h2>
      </ScrollReveal>
      <div class="mt-6 grid gap-4 sm:grid-cols-2">
        <ScrollReveal delay={0.05}>
          <a
            href={`${BASE_URL}solution/feedbackwriter/`}
            class="group flex items-center justify-between rounded-xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
          >
            <div>
              <span class="bg-umich-blue/10 text-umich-blue rounded-full px-2 py-0.5 text-xs font-semibold">FeedbackWriter</span>
              <p class="mt-2 text-sm text-gray-600">Help TAs provide high-quality, rubric-aligned feedback at scale.</p>
            </div>
            <span class="text-umich-blue ml-4 shrink-0 text-sm font-semibold group-hover:underline">→</span>
          </a>
        </ScrollReveal>
        <ScrollReveal delay={0.1}>
          <a
            href={`${BASE_URL}solution/draftmentors/`}
            class="group flex items-center justify-between rounded-xl border border-gray-100 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
          >
            <div>
              <span class="bg-umich-maize/20 text-umich-blue rounded-full px-2 py-0.5 text-xs font-semibold">DraftMentors</span>
              <p class="mt-2 text-sm text-gray-600">Give students instant, rubric-aligned feedback and tutoring on their drafts.</p>
            </div>
            <span class="text-umich-blue ml-4 shrink-0 text-sm font-semibold group-hover:underline">→</span>
          </a>
        </ScrollReveal>
      </div>
    </section>

    <!-- CTA -->
    <section
      class="mx-auto max-w-none p-16 lg:max-w-6xl"
      aria-labelledby="id-cta-heading"
    >
      <ScrollReveal>
        <div class="rounded-2xl bg-gradient-to-br from-umich-blue to-[#002d5e] px-8 py-12 text-center shadow-xl">
          <h2 id="id-cta-heading" class="text-2xl font-semibold text-white">
            Work with us
          </h2>
          <p class="mx-auto mt-4 max-w-xl text-pretty text-white/80">
            Interested in bringing the Instructor Dashboard to your course?
            Tell us about your teaching context and we'll follow up.
          </p>
          <a
            href={`${BASE_URL}signup/`}
            class="bg-umich-maize text-umich-blue mt-8 inline-block rounded-lg px-6 py-3 text-sm font-semibold transition hover:brightness-95 focus:outline-none"
          >
            Get in touch
          </a>
        </div>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
