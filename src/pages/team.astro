---

<Layout
  title="Our Team | Mentor AI"
  description="Learn more about the people behind Mentor AI."
  canonicalPath="/team"
>
  <Header />
  <main id="main-content" role="main" class="bg-background flex-1">
    <section
      class="mx-auto max-w-none px-6 pt-12 pb-24 md:px-8 md:pt-20 md:pb-40 lg:max-w-6xl"
    >
      <div class="mx-auto max-w-2xl lg:mx-0">
        <ScrollReveal client:idle>
          <h1
            class="text-umich-blue text-4xl font-semibold tracking-tight text-balance sm:text-5xl"
          >
            Our Team
          </h1>
        </ScrollReveal>
        <ScrollReveal client:load delay={0.1}>
          <p class="mt-6 text-lg/8">
            Meet our interdisciplinary research team working on scalable
            AI-assisted feedback ecosystems for higher education, empowering
            instructors to scale personalized support and improve student
            learning outcomes on open-ended assignments.
          </p>
        </ScrollReveal>
      </div>
      <ScrollReveal client:load delay={0.2}>
        <div class="mx-auto mt-12 max-w-2xl lg:mx-0">
          <h2
            class="text-umich-blue text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
          >
            Faculty
          </h2>
        </div>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.3}>
        <ul
          role="list"
          class="mx-auto mt-8 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-16 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3"
        >
          {
            faculty.map((member) => (
              <li>
                <TeamMemberCard {...member} />
              </li>
            ))
          }
        </ul>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.4}>
        <div class="mx-auto mt-12 max-w-2xl lg:mx-0">
          <h2
            class="text-umich-blue text-3xl font-semibold tracking-tight text-balance sm:text-4xl"
          >
            Research Team
          </h2>
        </div>
      </ScrollReveal>
      <ScrollReveal client:load delay={0.5}>
        <ul
          role="list"
          class="mx-auto mt-8 grid max-w-2xl grid-cols-1 gap-x-8 gap-y-12 sm:grid-cols-2 lg:mx-0 lg:max-w-none lg:grid-cols-3"
        >
          {
            researchers.map((member) => (
              <li>
                <TeamMemberCard {...member} />
              </li>
            ))
          }
        </ul>
      </ScrollReveal>
    </section>
  </main>
  <Footer />
</Layout>
